Карта НПЗ =
VAR PointWidth = 1200
VAR PointHeight = 620

/* Географические границы области карты */
VAR MinLon = 20
VAR MaxLon = 180
VAR MinLat = 40
VAR MaxLat = 82

/* -------------------------------------------
   Точки из таблицы координат
   ------------------------------------------- */

VAR Points =
    CONCATENATEX(
        FILTER(
            'Таблица координат',
            NOT ISBLANK('Таблица координат'[Долгота])
                &&
            NOT ISBLANK('Таблица координат'[Широта])
                &&
            NOT ISBLANK('Таблица координат'[НПЗ])
        ),

        VAR Lon =
            'Таблица координат'[Долгота]

        VAR Lat =
            'Таблица координат'[Широта]

        VAR Name =
            'Таблица координат'[НПЗ]

        /*
        Преобразуем географические координаты
        в координаты SVG.

        X:
        20° -> 60
        180° -> 1140

        Y:
        82° -> верх
        40° -> низ
        */

        VAR X =
            60
                +
            DIVIDE(
                Lon - MinLon,
                MaxLon - MinLon
            ) * 1080

        VAR Y =
            70
                +
            DIVIDE(
                MaxLat - Lat,
                MaxLat - MinLat
            ) * 500

        /*
        Экранируем специальные HTML-символы
        в названии НПЗ
        */

        VAR SafeName =
            SUBSTITUTE(
                SUBSTITUTE(
                    SUBSTITUTE(
                        SUBSTITUTE(
                            Name,
                            "&",
                            "&amp;"
                        ),
                        "<",
                        "&lt;"
                    ),
                    ">",
                    "&gt;"
                ),
                "'",
                "&#39;"
            )

        RETURN

            "<g class='npz-point'>"

                /*
                внешнее кольцо
                */

                & "<circle "
                    & "cx='" & FORMAT(X,"0.0")
                    & "' "
                    & "cy='" & FORMAT(Y,"0.0")
                    & "' "
                    & "r='9' "
                    & "class='point-halo' />"

                /*
                сама точка
                */

                & "<circle "
                    & "cx='" & FORMAT(X,"0.0")
                    & "' "
                    & "cy='" & FORMAT(Y,"0.0")
                    & "' "
                    & "r='5' "
                    & "class='point' />"

                /*
                подпись
                */

                & "<text "
                    & "x='" & FORMAT(X + 10,"0.0")
                    & "' "
                    & "y='" & FORMAT(Y - 9,"0.0")
                    & "' "
                    & "class='npz-label'>"
                    & SafeName
                    & "</text>"

            & "</g>",

        ""
    )


/* -------------------------------------------
   HTML / SVG
   ------------------------------------------- */

