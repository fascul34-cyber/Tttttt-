# Чем больше значение — тем выше плашка относительно точки.
LABEL_HEIGHT = 1.2

# Минимальное расстояние между соседними плашками
MIN_LON_DISTANCE = 1.5


def calculate_label_positions(df):
    """
    Раздвигает плашки по горизонтали,
    чтобы они меньше перекрывались.
    """

    points = []

    for _, row in df.iterrows():

        points.append({
            'lat': row['lat'],
            'lon': row['lon'],
            'station': row['Станция отправления'],
            'company': row['НПЗ'],
            'volume': row['Средняя мощность переработки в месяц, т']
        })

    # Сначала сортируем по широте.
    # Верхние плашки обрабатываем отдельно.
    points.sort(key=lambda x: x['lat'], reverse=True)

    placed = []

    for point in points:

        label_lon = point['lon']

        # Ищем уже размещённые плашки рядом
        while any(
            abs(label_lon - p['label_lon']) < MIN_LON_DISTANCE
            and abs(
                (point['lat'] + LABEL_HEIGHT) -
                p['label_lat']
            ) < 2.0
            for p in placed
        ):
            label_lon += MIN_LON_DISTANCE

        point['label_lon'] = label_lon
        point['label_lat'] = point['lat'] + LABEL_HEIGHT

        placed.append(point)

    return placed


