def extract_boundary_coords(geojson):
    lons = []
    lats = []

    for feature in geojson['features']:
        geom_type = feature['geometry']['type']
        coords = feature['geometry']['coordinates']

        if geom_type == 'Polygon':

            for ring in coords:
                for point in ring:
                    lons.append(point[0])
                    lats.append(point[1])

                lons.append(None)
                lats.append(None)

        elif geom_type == 'MultiPolygon':

            for polygon in coords:
                for ring in polygon:

                    for point in ring:
                        lons.append(point[0])
                        lats.append(point[1])

                    lons.append(None)
                    lats.append(None)

    return lons, lats


